# Engine: auto | claude-cli | ollama | anthropic
# AGENT_TEAM_ENGINE=claude-cli

# Optional model override (Ollama model name, or Anthropic model id)
# AGENT_TEAM_MODEL=qwen2.5-coder:7b

# Ollama URL (default http://127.0.0.1:11434)
# OLLAMA_HOST=http://127.0.0.1:11434

# Paid Anthropic API — only used if AGENT_TEAM_ENGINE=anthropic
# or AGENT_TEAM_ALLOW_PAID_API=1 with a key set:
# ANTHROPIC_API_KEY=sk-ant-...
